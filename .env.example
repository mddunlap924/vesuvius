# Copy to `.env` and adjust. `.env` is gitignored and never committed.
#
#   cp .env.example .env
#   set -a && source .env && set +a

# Repository root. Data, models, outputs and configs are resolved relative to it.
BASE_DIR=.

# Scratch space for preprocessed volumes and generated synthetic data.
NVME_DIR=./data

# Device selection and allocator tuning.
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Weights & Biases. Leave WANDB_ENTITY empty to use your account's default entity;
# the project name itself comes from configs/wandb/wandb.yaml.
WANDB_ENTITY=
